generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(cuid())
  username            String               @unique
  passwordHash        String
  createdAt           DateTime             @default(now())
  sessions            Session[]
  goals               Goal[]
  weeklyGoalTemplates WeeklyGoalTemplate[]
  moneyPlans          MoneyPlan[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Goal {
  id          String    @id @default(cuid())
  userId      String
  title       String
  description String
  targetCount Int?
  startDate   DateTime
  endDate     DateTime
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkIns  CheckIn[]
}

model CheckIn {
  id        String   @id @default(cuid())
  goalId    String
  date      String
  completed Boolean  @default(false)
  createdAt DateTime @default(now())

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@unique([goalId, date])
}

model WeeklyGoalTemplate {
  id          String               @id @default(cuid())
  userId      String
  title       String
  description String
  deletedAt   DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  instances WeeklyGoalInstance[]
}

model WeeklyGoalInstance {
  id                  String             @id @default(cuid())
  templateId          String
  titleSnapshot       String
  descriptionSnapshot String
  weekStartDate       String
  weekEndDate         String
  completed           Boolean            @default(false)
  completedAt         DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  template WeeklyGoalTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, weekStartDate])
}

model MoneyPlan {
  id            String   @id @default(cuid())
  userId        String
  title         String
  startAmount   Int
  finalAmount   Int
  deadline      DateTime
  currentAmount Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  stages MoneyStage[]
  logs   MoneyAmountLog[]

  @@index([userId])
}

model MoneyStage {
  id           String @id @default(cuid())
  planId       String
  order        Int
  title        String
  targetAmount Int
  windowStart  String
  windowEnd    String
  deltaLabel   String
  failLine     String

  plan    MoneyPlan          @relation(fields: [planId], references: [id], onDelete: Cascade)
  actions MoneyStageAction[]

  @@unique([planId, order])
}

model MoneyStageAction {
  id      String  @id @default(cuid())
  stageId String
  order   Int
  text    String
  done    Boolean @default(false)

  stage MoneyStage @relation(fields: [stageId], references: [id], onDelete: Cascade)

  @@unique([stageId, order])
}

model MoneyAmountLog {
  id        String   @id @default(cuid())
  planId    String
  amount    Int
  note      String?
  createdAt DateTime @default(now())

  plan MoneyPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, createdAt])
}
